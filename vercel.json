
{
  "installCommand": "git clone --depth 1 --branch stable https://github.com/flutter/flutter.git /tmp/flutter && /tmp/flutter/bin/flutter --version",
  "buildCommand": "/tmp/flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
