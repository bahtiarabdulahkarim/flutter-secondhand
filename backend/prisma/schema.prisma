generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model activity_logs {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt?  @db.UnsignedBigInt
  action      String   @db.VarChar(100)
  entity_type String?  @db.VarChar(100)
  entity_id   BigInt?  @db.UnsignedBigInt
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(0)
  users       users?   @relation(fields: [user_id], references: [id], map: "fk_activity_logs_user")

  @@index([action], map: "idx_activity_logs_action")
  @@index([created_at], map: "idx_activity_logs_created")
  @@index([entity_type, entity_id], map: "idx_activity_logs_entity")
  @@index([user_id], map: "idx_activity_logs_user")
}

model approvals {
  id                                  BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  requested_by                        BigInt           @db.UnsignedBigInt
  approved_by                         BigInt?          @db.UnsignedBigInt
  action_type                         String           @db.VarChar(100)
  entity_type                         String           @db.VarChar(100)
  entity_id                           BigInt?          @db.UnsignedBigInt
  request_data                        Json?
  reason                              String?          @db.Text
  status                              approvals_status @default(pending)
  approval_notes                      String?          @db.Text
  requested_at                        DateTime         @default(now()) @db.Timestamp(0)
  reviewed_at                         DateTime?        @db.DateTime(0)
  users_approvals_approved_byTousers  users?           @relation("approvals_approved_byTousers", fields: [approved_by], references: [id], map: "fk_approvals_approver")
  users_approvals_requested_byTousers users            @relation("approvals_requested_byTousers", fields: [requested_by], references: [id], map: "fk_approvals_requester")

  @@index([approved_by], map: "idx_approvals_approver")
  @@index([entity_type, entity_id], map: "idx_approvals_entity")
  @@index([requested_by], map: "idx_approvals_requester")
  @@index([status], map: "idx_approvals_status")
}

model brands {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name           String           @unique(map: "uq_brands_name") @db.VarChar(100)
  logo_url       String?          @db.VarChar(500)
  created_at     DateTime         @default(now()) @db.DateTime(0)
  updated_at     DateTime         @default(now()) @db.DateTime(0)
  vehicle_models vehicle_models[]
}

model categories {
  id             Int              @id @default(autoincrement()) @db.UnsignedTinyInt
  name           String           @unique(map: "uq_categories_name") @db.VarChar(50)
  slug           String           @unique(map: "uq_categories_slug") @db.VarChar(60)
  description    String?          @db.VarChar(255)
  created_at     DateTime         @default(now()) @db.DateTime(0)
  vehicle_models vehicle_models[]
}

model conversation_participants {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id BigInt        @db.UnsignedBigInt
  user_id         BigInt        @db.UnsignedBigInt
  joined_at       DateTime      @default(now()) @db.Timestamp(0)
  last_read_at    DateTime?     @db.DateTime(0)
  is_active       Boolean       @default(true)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, map: "fk_participants_conversation")
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_participants_user")

  @@unique([conversation_id, user_id], map: "uq_conversation_participant")
  @@index([user_id], map: "idx_conversation_participants_user")
}

model conversations {
  id                        BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_code         String                          @unique(map: "conversation_code") @db.VarChar(50)
  conversation_type         conversations_conversation_type @default(customer_admin)
  created_by                BigInt                          @db.UnsignedBigInt
  last_message_at           DateTime?                       @db.DateTime(0)
  archived_at               DateTime?                       @db.DateTime(0)
  created_at                DateTime                        @default(now()) @db.Timestamp(0)
  updated_at                DateTime                        @default(now()) @db.Timestamp(0)
  conversation_participants conversation_participants[]
  users                     users                           @relation(fields: [created_by], references: [id], map: "fk_conversations_creator")
  messages                  messages[]

  @@index([created_by], map: "idx_conversations_creator")
  @@index([last_message_at], map: "idx_conversations_last_message")
}

model message_attachments {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  message_id BigInt   @db.UnsignedBigInt
  file_url   String   @db.VarChar(500)
  file_name  String?  @db.VarChar(255)
  file_type  String?  @db.VarChar(100)
  file_size  BigInt?  @db.UnsignedBigInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  messages   messages @relation(fields: [message_id], references: [id], onDelete: Cascade, map: "fk_message_attachments_message")

  @@index([message_id], map: "idx_message_attachments_message")
}

model messages {
  id                               BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id                  BigInt                @db.UnsignedBigInt
  sender_id                        BigInt                @db.UnsignedBigInt
  message_type                     messages_message_type @default(text)
  message_content                  String?               @db.Text
  sent_at                          DateTime              @default(now()) @db.Timestamp(0)
  edited_at                        DateTime?             @db.DateTime(0)
  deleted_at                       DateTime?             @db.DateTime(0)
  deleted_by                       BigInt?               @db.UnsignedBigInt
  deletion_reason                  String?               @db.VarChar(255)
  message_attachments              message_attachments[]
  conversations                    conversations         @relation(fields: [conversation_id], references: [id], onDelete: Cascade, map: "fk_messages_conversation")
  users_messages_deleted_byTousers users?                @relation("messages_deleted_byTousers", fields: [deleted_by], references: [id], map: "fk_messages_deleted_by")
  users_messages_sender_idTousers  users                 @relation("messages_sender_idTousers", fields: [sender_id], references: [id], map: "fk_messages_sender")

  @@index([deleted_by], map: "fk_messages_deleted_by")
  @@index([conversation_id], map: "idx_messages_conversation")
  @@index([sender_id], map: "idx_messages_sender")
  @@index([sent_at], map: "idx_messages_sent_at")
}

model notifications {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt    @db.UnsignedBigInt
  title             String    @db.VarChar(200)
  message           String    @db.Text
  notification_type String    @db.VarChar(50)
  reference_type    String?   @db.VarChar(100)
  reference_id      BigInt?   @db.UnsignedBigInt
  is_read           Boolean   @default(false)
  read_at           DateTime? @db.DateTime(0)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notifications_user")

  @@index([created_at], map: "idx_notifications_created")
  @@index([user_id, is_read], map: "idx_notifications_read")
  @@index([reference_type, reference_id], map: "idx_notifications_reference")
  @@index([user_id], map: "idx_notifications_user")
}

model roles {
  id          Int          @id @default(autoincrement()) @db.UnsignedTinyInt
  role_name   String       @unique(map: "uq_roles_role_name") @db.VarChar(30)
  description String?      @db.VarChar(255)
  created_at  DateTime     @default(now()) @db.DateTime(0)
  user_roles  user_roles[]
}

model showroom_settings {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  showroom_name   String   @db.VarChar(150)
  description     String?  @db.Text
  address         String?  @db.Text
  phone           String?  @db.VarChar(25)
  email           String?  @db.VarChar(150)
  logo_url        String?  @db.VarChar(500)
  opening_hours   Json?
  whatsapp_number String?  @db.VarChar(25)
  updated_by      BigInt?  @db.UnsignedBigInt
  created_at      DateTime @default(now()) @db.Timestamp(0)
  updated_at      DateTime @default(now()) @db.Timestamp(0)
  users           users?   @relation(fields: [updated_by], references: [id], map: "fk_showroom_settings_updater")

  @@index([updated_by], map: "idx_showroom_settings_updater")
}

model test_drive_status_history {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  test_drive_id BigInt      @db.UnsignedBigInt
  old_status    String?     @db.VarChar(30)
  new_status    String      @db.VarChar(30)
  changed_by    BigInt?     @db.UnsignedBigInt
  notes         String?     @db.Text
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  test_drives   test_drives @relation(fields: [test_drive_id], references: [id], onDelete: Cascade, map: "fk_test_drive_history_booking")
  users         users?      @relation(fields: [changed_by], references: [id], map: "fk_test_drive_history_user")

  @@index([test_drive_id], map: "idx_test_drive_history_booking")
  @@index([created_at], map: "idx_test_drive_history_date")
  @@index([changed_by], map: "idx_test_drive_history_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model test_drives {
  id                                         BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  booking_code                               String                      @unique(map: "booking_code") @db.VarChar(50)
  user_id                                    BigInt                      @db.UnsignedBigInt
  vehicle_id                                 BigInt                      @db.UnsignedBigInt
  assigned_admin_id                          BigInt?                     @db.UnsignedBigInt
  scheduled_date                             DateTime                    @db.Date
  start_time                                 DateTime                    @db.Time(0)
  end_time                                   DateTime                    @db.Time(0)
  status                                     test_drives_status          @default(pending)
  customer_notes                             String?                     @db.Text
  admin_notes                                String?                     @db.Text
  approved_by                                BigInt?                     @db.UnsignedBigInt
  approved_at                                DateTime?                   @db.DateTime(0)
  created_at                                 DateTime                    @default(now()) @db.Timestamp(0)
  updated_at                                 DateTime                    @default(now()) @db.Timestamp(0)
  test_drive_status_history                  test_drive_status_history[]
  users_test_drives_assigned_admin_idTousers users?                      @relation("test_drives_assigned_admin_idTousers", fields: [assigned_admin_id], references: [id], map: "fk_test_drives_admin")
  users_test_drives_approved_byTousers       users?                      @relation("test_drives_approved_byTousers", fields: [approved_by], references: [id], map: "fk_test_drives_approver")
  users_test_drives_user_idTousers           users                       @relation("test_drives_user_idTousers", fields: [user_id], references: [id], map: "fk_test_drives_user")
  vehicles                                   vehicles                    @relation(fields: [vehicle_id], references: [id], map: "fk_test_drives_vehicle")

  @@index([approved_by], map: "fk_test_drives_approver")
  @@index([assigned_admin_id], map: "idx_test_drives_admin")
  @@index([scheduled_date, start_time, end_time], map: "idx_test_drives_schedule")
  @@index([status], map: "idx_test_drives_status")
  @@index([user_id], map: "idx_test_drives_user")
  @@index([vehicle_id], map: "idx_test_drives_vehicle")
}

model transaction_documents {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  transaction_id    BigInt       @db.UnsignedBigInt
  document_type     String       @db.VarChar(50)
  file_url          String       @db.VarChar(500)
  original_filename String?      @db.VarChar(255)
  uploaded_by       BigInt?      @db.UnsignedBigInt
  created_at        DateTime     @default(now()) @db.Timestamp(0)
  transactions      transactions @relation(fields: [transaction_id], references: [id], onDelete: Cascade, map: "fk_transaction_documents_transaction")
  users             users?       @relation(fields: [uploaded_by], references: [id], map: "fk_transaction_documents_uploader")

  @@index([transaction_id], map: "idx_transaction_documents_transaction")
  @@index([uploaded_by], map: "idx_transaction_documents_uploader")
}

