  @@index([vehicle_id], map: "idx_vehicle_costs_vehicle_id")
}

model vehicle_images {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  vehicle_id BigInt   @db.UnsignedBigInt
  image_url  String   @db.VarChar(500)
  public_id  String?  @db.VarChar(255)
  is_primary Boolean  @default(false)
  sort_order Int      @default(0) @db.UnsignedInt
  created_at DateTime @default(now()) @db.DateTime(0)
  vehicles   vehicles @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, map: "fk_vehicle_images_vehicle")

  @@index([vehicle_id, is_primary], map: "idx_vehicle_images_primary")
  @@index([vehicle_id], map: "idx_vehicle_images_vehicle_id")
}

model vehicle_models {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  brand_id    BigInt     @db.UnsignedBigInt
  category_id Int        @db.UnsignedTinyInt
  model_name  String     @db.VarChar(100)
  created_at  DateTime   @default(now()) @db.DateTime(0)
  updated_at  DateTime   @default(now()) @db.DateTime(0)
  brands      brands     @relation(fields: [brand_id], references: [id], map: "fk_vehicle_models_brand")
  categories  categories @relation(fields: [category_id], references: [id], map: "fk_vehicle_models_category")
  vehicles    vehicles[]

  @@unique([brand_id, category_id, model_name], map: "uq_vehicle_models_brand_category_name")
  @@index([category_id], map: "idx_vehicle_models_category_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vehicles {
  id                               BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  model_id                         BigInt              @db.UnsignedBigInt
  vehicle_code                     String              @unique(map: "uq_vehicles_vehicle_code") @db.VarChar(30)
  title                            String              @db.VarChar(150)
  year                             Int                 @db.Year
  price                            Decimal             @db.Decimal(15, 2)
  mileage                          Int?                @db.UnsignedInt
  transmission                     String?             @db.VarChar(30)
  fuel_type                        String?             @db.VarChar(30)
  color                            String?             @db.VarChar(50)
  engine_capacity                  Int?                @db.UnsignedInt
  engine_number                    String?             @unique(map: "uq_vehicles_engine_number") @db.VarChar(100)
  chassis_number                   String?             @unique(map: "uq_vehicles_chassis_number") @db.VarChar(100)
  license_plate                    String?             @db.VarChar(20)
  description                      String?             @db.Text
  vehicle_condition                String              @default("good") @db.VarChar(30)
  status                           String              @default("available") @db.VarChar(30)
  is_featured                      Boolean             @default(false)
  created_by                       BigInt?             @db.UnsignedBigInt
  updated_by                       BigInt?             @db.UnsignedBigInt
  created_at                       DateTime            @default(now()) @db.DateTime(0)
  updated_at                       DateTime            @default(now()) @db.DateTime(0)
  deleted_at                       DateTime?           @db.DateTime(0)
  test_drives                      test_drives[]
  transaction_items                transaction_items[]
  vehicle_costs                    vehicle_costs[]
  vehicle_images                   vehicle_images[]
  users_vehicles_created_byTousers users?              @relation("vehicles_created_byTousers", fields: [created_by], references: [id], map: "fk_vehicles_created_by")
  vehicle_models                   vehicle_models      @relation(fields: [model_id], references: [id], map: "fk_vehicles_model")
  users_vehicles_updated_byTousers users?              @relation("vehicles_updated_byTousers", fields: [updated_by], references: [id], map: "fk_vehicles_updated_by")

  @@index([created_by], map: "fk_vehicles_created_by")
  @@index([updated_by], map: "fk_vehicles_updated_by")
  @@index([created_at], map: "idx_vehicles_created_at")
  @@index([deleted_at], map: "idx_vehicles_deleted_at")
  @@index([is_featured], map: "idx_vehicles_is_featured")
  @@index([model_id], map: "idx_vehicles_model_id")
  @@index([price], map: "idx_vehicles_price")
  @@index([status], map: "idx_vehicles_status")
  @@index([year], map: "idx_vehicles_year")
}

